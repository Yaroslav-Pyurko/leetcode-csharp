<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- Deliberately no <Optimize>true</Optimize> here.
         BenchmarkDotNet's OptimizationsValidator checks the whole reference graph,
         so forcing optimization on this project alone does not help - the Debug
         build of src/LeetCode still fails validation, and the resulting error only
         names that dependency, which is more confusing than the plain message.
         Always run with -c Release; see README.md. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LeetCode\LeetCode.csproj" />
  </ItemGroup>

</Project>
